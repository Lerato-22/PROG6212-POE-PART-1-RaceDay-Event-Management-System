@model List<RaceDay.MVC.Models.EventModel>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h4>Organiser Dashboard</h4>
    <p>Overview of your events and participant activity</p>
</div>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="stat-tile">
            <div class="stat-number">@Model.Count</div>
            <div class="stat-label">Total Events</div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-tile">
            <div class="stat-number">@Model.Sum(e => e.TotalEnrolments)</div>
            <div class="stat-label">Total Enrolments</div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-tile">
            <div class="stat-number">@Model.Count(e => e.Date >= DateTime.Today)</div>
            <div class="stat-label">Upcoming Events</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>My Events</span>
        <a asp-action="CreateEvent" class="btn btn-sm btn-light">+ New Event</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No events yet. Create your first event to get started.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Enrolments</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@ev.Name</td>
                                <td>@ev.Date.ToString("dd MMM yyyy")</td>
                                <td>@ev.Location</td>
                                <td><span class="badge bg-secondary">@ev.EventType</span></td>
                                <td>@ev.TotalEnrolments</td>
                                <td>
                                    <a asp-action="Categories" asp-route-eventId="@ev.EventId"
                                       class="btn btn-sm btn-outline-secondary me-1">Categories</a>
                                    <a asp-action="Enrolments" asp-route-eventId="@ev.EventId"
                                       class="btn btn-sm btn-outline-primary me-1">Enrolments</a>
                                    <a asp-action="Results" asp-route-eventId="@ev.EventId"
                                       class="btn btn-sm btn-outline-warning me-1">Results</a>
                                    <a asp-action="EditEvent" asp-route-id="@ev.EventId"
                                       class="btn btn-sm btn-outline-success me-1">Edit</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@ev.EventId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this event?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
