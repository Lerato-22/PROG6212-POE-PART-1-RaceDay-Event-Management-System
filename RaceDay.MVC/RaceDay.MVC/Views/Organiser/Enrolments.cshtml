@model List<RaceDay.MVC.Models.EnrolmentModel>
@{
    ViewData["Title"] = "Enrolments";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4>Event Enrolments</h4>
        <p>All participants enrolled for this event</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">Back to Dashboard</a>
</div>

<div class="card">
    <div class="card-header">Enrolled Participants</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-4">No participants have enrolled for this event yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrolment in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@enrolment.ParticipantName</td>
                                <td>@enrolment.CategoryName</td>
                                <td>
                                    @if (enrolment.Status == "Confirmed")
                                    {
                                        <span class="status-confirmed">Confirmed</span>
                                    }
                                    else if (enrolment.Status == "Pending")
                                    {
                                        <span class="status-pending">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="status-cancelled">Cancelled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
