@model List<RaceDay.MVC.Models.ResultModel>
@{
    ViewData["Title"] = "Results";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h4>Event Results</h4>
        <p>Capture and view finishing times for this event</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">Back to Dashboard</a>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header">Capture Result</div>
            <div class="card-body p-4">
                <form asp-action="AddResult" method="post">
                    <input type="hidden" name="EventId" value="@ViewBag.EventId" />
                    <div class="mb-3">
                        <label class="form-label">Participant</label>
                        <select name="EnrolmentId" class="form-select">
                            <option value="">-- Select participant --</option>
                            @foreach (var e in (List<RaceDay.MVC.Models.EnrolmentModel>)ViewBag.Enrolments)
                            {
                                <option value="@e.EnrolmentId">@e.ParticipantName (@e.CategoryName)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Finish Time (hh:mm:ss)</label>
                        <input name="FinishTime" class="form-control" placeholder="e.g. 02:45:30" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Finishing Position</label>
                        <input name="FinishingPosition" type="number" class="form-control" placeholder="e.g. 47" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Total Finishers</label>
                        <input name="TotalFinishers" type="number" class="form-control" placeholder="e.g. 312" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Result</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Recorded Results</div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted text-center py-4">No results captured yet.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@result.ParticipantName</td>
                                    <td>@result.CategoryName</td>
                                    <td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td>
                                    <td>@result.FinishingPosition of @result.TotalFinishers</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
