@model List<RaceDay.MVC.Models.EnrolmentModel>
@{
    ViewData["Title"] = "My Events";
}

<div class="page-header">
    <h4>My Events</h4>
    <p>Events you have enrolled in</p>
</div>

<div class="card">
    <div class="card-header">Enrolment History</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-5">
                You have not enrolled in any events yet.
                <a asp-action="Index">Browse upcoming events</a>
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Category</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var enrolment in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@enrolment.EventName</td>
                                <td>@enrolment.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@enrolment.CategoryName</td>
                                <td>
                                    @if (enrolment.Status == "Confirmed")
                                    {
                                        <span class="status-confirmed">Confirmed</span>
                                    }
                                    else if (enrolment.Status == "Pending")
                                    {
                                        <span class="status-pending">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="status-cancelled">Cancelled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
