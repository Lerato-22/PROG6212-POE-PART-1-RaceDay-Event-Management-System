@model List<RaceDay.MVC.Models.ResultModel>
@{
    ViewData["Title"] = "My Results";
}

<div class="page-header">
    <h4>My Results</h4>
    <p>Your personal race history and finishing positions</p>
</div>

<div class="card">
    <div class="card-header">Race History</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted text-center py-5">
                No results recorded yet. Results are captured by the organiser after an event concludes.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Finish Time</th>
                            <th>Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@result.EventName</td>
                                <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@result.CategoryName</td>
                                <td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td>
                                <td>@result.FinishingPosition of @result.TotalFinishers</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
