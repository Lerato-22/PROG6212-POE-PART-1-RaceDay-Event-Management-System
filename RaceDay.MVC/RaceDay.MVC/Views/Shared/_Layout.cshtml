<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var user = RaceDay.MVC.Services.SessionHelper.GetUser(Context.Session);
    }

    <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">RaceDay</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (user != null && user.Role == "Organiser")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a>
                        </li>
                    }
                    else if (user != null && user.Role == "Participant")
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (user != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">@user.FullName &nbsp;|&nbsp; @user.Role</span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm mt-1">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer mt-5 py-3 raceday-footer">
        <div class="container text-center">
            <span class="text-light">&copy; 2026 RaceDay. All rights reserved.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>